#!/usr/bin/env bash

set -euo pipefail

die() {
  printf 'askill: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: askill

Choose a skill, project (a sibling folder or this repository), installed
provider, and mode, then open the provider's interactive CLI in that project
with the skill as its first prompt.

Modes:
  auto  The provider's own auto mode: works without stopping at every
        approval, with its sandbox and deny rules still in force.
  plan  The provider's read-only planning mode.

In each menu, use the arrow keys (left/right jump to the first/last entry) and
Enter, or type the entry's number.
EOF
}

pick() {
  local title="$1"
  shift

  printf '\n%s\n' "$title" >&2
  if [[ -t 0 && -t 2 ]]; then
    pick_keys "$@"
  else
    pick_line "$@"
  fi
}

pick_line() {
  local choice number

  local i=1
  for choice in "$@"; do
    printf '  %d) %s\n' "$i" "$choice" >&2
    i=$((i + 1))
  done

  while true; do
    printf '> ' >&2
    IFS= read -r choice || die 'selection cancelled'
    case "$choice" in
      ''|*[!0-9]*) printf 'Enter a number from 1 to %d.\n' "$#" >&2 ;;
      *) number=$((10#$choice))
         if (( number >= 1 && number <= $# )); then
           PICKED=$((number - 1))
           return
         fi
         printf 'Enter a number from 1 to %d.\n' "$#" >&2 ;;
    esac
  done
}

# Up/down move one row, left/right jump to the first/last row, digits jump to
# that number, and Enter chooses the highlighted row.
pick_keys() {
  local esc=$'\033'
  local current=0 typed='' key next choice i

  printf '%s[?25l' "$esc" >&2
  trap 'printf "\033[?25h" >&2' EXIT
  trap 'printf "\n" >&2; exit 130' INT

  while true; do
    i=0
    for choice in "$@"; do
      if (( i == current )); then
        printf '%s[2K%s[7m> %d) %s%s[0m\n' "$esc" "$esc" "$((i + 1))" "$choice" "$esc" >&2
      else
        printf '%s[2K  %d) %s\n' "$esc" "$((i + 1))" "$choice" >&2
      fi
      i=$((i + 1))
    done
    printf '%s[2K> %s' "$esc" "$typed" >&2

    IFS= read -rsn1 key || die 'selection cancelled'
    case "$key" in
      '') break ;;
      $'\004') printf '\n' >&2; die 'selection cancelled' ;;
      "$esc")
        typed=''
        IFS= read -rsn1 -t 1 key || key=''
        if [[ "$key" == '[' || "$key" == O ]]; then
          IFS= read -rsn1 -t 1 key || key=''
          case "$key" in
            A) (( current > 0 )) && current=$((current - 1)) ;;
            B) (( current < $# - 1 )) && current=$((current + 1)) ;;
            C) current=$(($# - 1)) ;;
            D) current=0 ;;
          esac
        fi
        ;;
      [0-9])
        for next in "$typed$key" "$key" ''; do
          [[ -z "$next" ]] && break
          if (( 10#$next >= 1 && 10#$next <= $# )); then
            current=$((10#$next - 1))
            break
          fi
        done
        typed="$next"
        ;;
      $'\177'|$'\b')
        typed="${typed%?}"
        [[ -n "$typed" ]] && current=$((10#$typed - 1))
        ;;
    esac
    printf '\r%s[%dA' "$esc" "$#" >&2
  done

  printf '\r%s[2K> %d\n%s[?25h' "$esc" "$((current + 1))" "$esc" >&2
  trap - EXIT INT
  PICKED=$current
}

if (( $# > 0 )); then
  case "$1" in
    -h|--help) usage; exit 0 ;;
    *) die 'this command takes no arguments; run askill to start' ;;
  esac
fi

self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  [[ "$self" == /* ]] || self="$dir/$self"
done
root="$(cd -P "$(dirname "$self")" && pwd)"

shopt -s nullglob

skill_files=()
skill_names=()
for dir in "$root"/skills/*/; do
  name="$(basename "$dir")"
  [[ "$name" == _* ]] && continue
  file="$dir/SKILL.md"
  [[ -f "$file" ]] || continue
  skill_files+=("$file")
  skill_names+=("$name")
done
(( ${#skill_files[@]} > 0 )) || die "no skills found in $root/skills"
pick 'Skill' "${skill_names[@]}"
skill_file="${skill_files[$PICKED]}"
skill_name="${skill_names[$PICKED]}"

projects=()
project_names=()
for candidate in "$root"/../*/; do
  project="$(cd -P "$candidate" && pwd)"
  projects+=("$project")
  project_names+=("$(basename "$project")")
done
pick 'Project' "${project_names[@]}"
project="${projects[$PICKED]}"
project_name="${project_names[$PICKED]}"

provider_names=()
provider_bins=()
provider_labels=()
known_names=(claude cursor codex copilot mistral opencode)
known_bins=(claude cursor-agent codex copilot vibe opencode)
known_labels=('Claude Code' 'Cursor Agent' 'Codex CLI' 'GitHub Copilot CLI' 'Mistral Vibe' 'opencode')
for i in "${!known_names[@]}"; do
  if command -v "${known_bins[$i]}" >/dev/null 2>&1; then
    provider_names+=("${known_names[$i]}")
    provider_bins+=("${known_bins[$i]}")
    provider_labels+=("${known_labels[$i]}")
  fi
done
(( ${#provider_names[@]} > 0 )) || die 'no supported provider CLI is installed'
pick 'Provider' "${provider_labels[@]}"
provider="${provider_names[$PICKED]}"
provider_bin="${provider_bins[$PICKED]}"
provider_label="${provider_labels[$PICKED]}"

modes=(auto plan)
pick 'Mode' "${modes[@]}"
mode="${modes[$PICKED]}"

# The frontmatter is metadata for skill discovery, not instructions, and its
# leading '---' would be read as a flag by providers taking the prompt in argv.
prompt="$(awk '
  NR == 1 && $0 == "---" { fm = 1; next }
  fm && $0 == "---"      { fm = 0; next }
  fm                     { next }
  !body && $0 == ""      { next }
                         { body = 1; print }
' "$skill_file")"
[[ -n "$prompt" ]] || die "$skill_file has no instructions"
cmd=("$provider_bin")

# auto is each CLI's own auto mode -- it works without stopping at every
# approval, but its sandbox and deny rules stay on. No bypass flags here.
case "$provider:$mode" in
  claude:auto)   cmd+=(--permission-mode auto) ;;
  claude:plan)   cmd+=(--permission-mode plan) ;;
  cursor:auto)   cmd+=(--sandbox enabled) ;;
  cursor:plan)   cmd+=(--mode plan) ;;
  codex:auto)    cmd+=(--sandbox workspace-write --ask-for-approval on-request) ;;
  codex:plan)    cmd+=(--sandbox read-only) ;;
  copilot:auto)  cmd+=(--mode autopilot) ;;
  copilot:plan)  cmd+=(--mode plan) ;;
  mistral:auto)  cmd+=(--agent accept-edits) ;;
  mistral:plan)  cmd+=(--agent plan) ;;
  opencode:auto) cmd+=(--agent build --auto) ;;
  opencode:plan) cmd+=(--agent plan) ;;
esac

case "$provider" in
  # The project was already chosen in this menu. Skip vibe's trust dialog so
  # a decline cannot abort the session before the skill prompt is sent.
  # Also skip the blocking startup update prompt: choosing "Update now"
  # exits vibe and drops the askill launch (skill + mode) entirely.
  mistral)
    cmd+=(--trust)
    export VIBE_ENABLE_UPDATE_CHECKS=false
    ;;
esac

case "$provider" in
  copilot)  cmd+=(--interactive "$prompt") ;;
  opencode) cmd+=(--prompt "$prompt") ;;
  *)        cmd+=("$prompt") ;;
esac

printf '\nOpening %s in %s with %s (%s).\n\n' \
  "$provider_label" "$project_name" "$skill_name" "$mode" >&2
cd "$project" || die "cannot enter $project"
exec "${cmd[@]}"
